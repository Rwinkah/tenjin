# Private key for an address registered as a LichessOracle attester on-chain.
# Local Hardhat default deployer (also added as attester by deploy script):
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# From Render env group (same as wager-backend `CHAIN_ID`). Default local Hardhat: 31337.
CHAIN_ID=31337

# Same name as wager-backend and Render env group (not ORACLE_ADDRESS).
LICHESS_ORACLE_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# Required for join permit validation (read lcWagerJoinSnapshot).
ETH_RPC_URL=http://127.0.0.1:8545
LICHESS_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Optional: verify directed challenge destination via Lichess API.
# LICHESS_API_TOKEN=

# HTTP port (default 3001 — avoids conflict with Next.js on 3000).
PORT=3001
